RewriteEngine On

# ======================================================================
# 1. SECURITY SETTINGS
# ======================================================================

# Internal directories are never served directly.
#   includes:  application code and configuration
#   templates: signature templates (read by PHP only; previews go through load_template.php)
#   lang:      translation files (read by PHP only)
RewriteRule ^(includes|templates|lang)(/|$) - [F,L]

# Never serve dotfiles, databases, logs, keys or backups, wherever they are.
<FilesMatch "(^\.|\.(db|sqlite|sqlite3|log|key|bak|old|orig|sql|lock|md)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Disable directory listing.
Options -Indexes

# Pass the Authorization header to PHP (needed by the Bearer-token API;
# Apache/CGI/FastCGI would otherwise drop it).
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Baseline headers for static files. PHP pages send a complete set
# (CSP, HSTS on HTTPS, ...) themselves, see includes/config.php.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always unset X-Powered-By

    # Stylesheets and scripts are revalidated on every request (cheap 304 if
    # unchanged). PHP pages add "?v=<mtime>" to the URLs, but assets that are
    # loaded dynamically (e.g. Ace modules/themes) rely on this, so no
    # browser keeps a stale copy after an update.
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# ======================================================================
# 2. API (api/v1): no pretty-URL redirect, every sub path goes to index.php
# ======================================================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/v1/.+$ api/v1/index.php [L,QSA]
RewriteRule ^api/ - [L]

# ======================================================================
# 3. URL REWRITING (pretty URLs)
# ======================================================================

# External redirect from .php to the extensionless URL (GET requests only).
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# Internal rewrite to the .php file.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*?)/?$ $1.php [L]
